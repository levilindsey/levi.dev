{
  "name": "levi.dev",
  "version": "2.0.0",
  "description": "Levi Lindsey's web portfolio",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/levilindsey/levi.dev"
  },
  "scripts": {
    "build": "node build.js",
    "preview": "npx --yes serve dist",
    "deploy": "node build.js && npx --yes wrangler pages deploy dist --project-name=levi-dev --branch=master --commit-dirty=true",
    "vendor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/vendor-hex-grid.ps1",
    "media:prepare": "node scripts/media-prepare.mjs",
    "media:upload": "node scripts/media-upload.mjs"
  },
  "devDependencies": {
    "lodash.template": "^4.5.0",
    "pug": "^3.0.3",
    "sharp": "^0.35.5"
  }
}
