- var baseDir = '/page-missing';

doctype html
html(lang='en')
  head
    title
      | Page Missing

    meta(charset='utf-8')
    meta(name='description', content='Levi Lindsey\'s web portfolio')
    meta(name='viewport', content='width=device-width')

    link(rel='icon', type='image/png', href=baseDir + '/images/favicon-16x16.png', sizes='16x16')
    link(rel='icon', type='image/png', href=baseDir + '/images/favicon-32x32.png', sizes='32x32')

    link(rel='stylesheet', href=baseDir + '/main.css')

  script(async, src='https://www.googletagmanager.com/gtag/js?id=' + portfolioAnalyticsScriptGA4ID)
  script
    | window.dataLayer = window.dataLayer || [];
    | function gtag(){dataLayer.push(arguments);}
    | gtag('js', new Date());
    | gtag('config', '#{portfolioAnalyticsScriptGA4ID}');

  body
    img(src=baseDir + '/images/maya.jpg', alt='A cat')
    h1
      | Page Missing
    p
      | Sorry, we couldn't find your page#{pageName ? ' at ' + pageName : ''}.<br><br>
      | ...so here's a picture of a cat instead!
    p
      | Why don't you start over from the&nbsp;
      a(href='/')
        | home page
      | ?
